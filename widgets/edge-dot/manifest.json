{
	"author": "Mathod95",
	"id": "com.mathod95.edgedot",
	"name": "Edge Dot – System Monitor",
	"description": "FPS en direct, 4 capteurs matériels et historique tactile, en style dot-matrix.",
	"version": "1.1.0",
	"preview_icon": "resources/icon.svg",
	"min_app_version": "5.47",
	"min_framework_version": "1.0.0",
	"os": [
		{
			"platform": "windows"
		}
	],
	"supported_devices": [
		{
			"type": "dashboard_lcd",
			"features": ["sensor-screen"]
		}
	],
	"interactive": true,
	"required_plugins": [
		"widgetbuilder.sensorsdataprovider:Sensors:1.0",
		"widgetbuilder.fpsdataprovider:Fps:1.0"
	]
}
